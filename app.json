{
  "expo": {
    "name": "مطاعم دريم سيتي",
    "slug": "dream-city-restaurants",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dreamcity",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffaf0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamcity.restaurants.demo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "تُستخدم الكاميرا لمسح رمز الطاولة عند طلبك.",
        "NSLocationWhenInUseUsageDescription": "يُستخدم موقع الموصل بعد موافقته لتحديث تتبع التوصيل."
      }
    },
    "android": {
      "package": "com.dreamcity.restaurants.demo",
      "adaptiveIcon": {
        "backgroundColor": "#fffaf0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "dreamcity"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "تُستخدم الكاميرا لمسح رمز الطاولة عند طلبك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يُستخدم موقع الموصل بعد موافقته لتحديث تتبع التوصيل."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fffaf0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

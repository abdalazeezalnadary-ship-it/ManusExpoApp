# Copy to .env locally. Never commit .env.
# Database/API server only
PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
# Comma-separated exact web origins allowed to call the API
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Public API base URL compiled into the Expo app (not a credential).
# For a physical phone, use the reachable HTTPS API URL or the computer's LAN IP.
EXPO_PUBLIC_API_URL=

# Optional one-time local staff bootstrap; leave blank unless intentionally creating an admin.
# The created account is forced to change its password on first login.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_BRANCH_CODE=dream-city-main

# Set these required values only in your local .env before starting MySQL via Docker Compose.
MYSQL_DATABASE=dreamcity
MYSQL_USER=dreamcity_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
